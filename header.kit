            <p>Email me @ <a href="mailto:cameron@cam.graphics">cameron@cam.graphics</a></p>
            <p><strong>OR</strong></p>

            <form method="POST" id="form">

                <input type="hidden" name="access_key" value="026616a2-444a-40b1-bb40-dac949b4e60f">
                <input type="hidden" name="subject" value="New Submission from Web3Forms">
                <input type="checkbox" name="botcheck" id="" style="display: none;">

                <!-- Custom Form Data -->
                <label for="email">eMail</label>
                <input type="email" name="email" id="email" required>
                <label for="email">Message</label>
                <textarea name="message" id="message" height="500px" required></textarea>

                <button type="submit">Submit</button>

                <div id="result"></div>

            </form>
